{
  "name": "maths-for-sg-primary-schools",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Singapore Primary 1\u20136 maths activities with school accounts and Standard/Foundation paths.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-seo.mjs && python3 scripts/check-seo.py && node scripts/build-redirects.mjs && node scripts/check-redirects.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "narration:plan": "node scripts/export-narration.mjs && node scripts/generate-premium-narration.mjs --all --dry-run",
    "test:narration": "node --test scripts/lib/premium-narration.test.mjs",
    "test:narration-assets": "node scripts/check-narration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {}
}
